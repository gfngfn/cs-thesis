use package open Testing
use CsThesis

module CsThesisTest = struct

  #[test]
  val repeat-string-test-0 () =
    assert-equal Equality.string ` ` (CsThesis.repeat-string 0 `A`)

  #[test]
  val repeat-string-test-1 () =
    assert-equal Equality.string `A` (CsThesis.repeat-string 1 `A`)

  #[test]
  val repeat-string-test-2 () =
    assert-equal Equality.string `AAA` (CsThesis.repeat-string 3 `A`)

  #[test]
  val roman-numeral-test () =
    assert-equal Equality.string `I` (CsThesis.roman-numeral 1)

end
